{
  "name": "wisp-desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "WispAI — 100% Local AI Multi-Speaker Meeting Transcriber & Translator",
  "author": "starchap",
  "license": "MIT",
  "homepage": "https://github.com/starchap/Wisp",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:vite": "vite --port 5173",
    "dev:electron": "electron .",
    "build": "tsc -b && vite build",
    "dist:win": "npm run build && electron-builder --win nsis portable zip appx",
    "dist:mac": "npm run build && electron-builder --mac dmg zip",
    "dist:linux": "npm run build && electron-builder --linux deb rpm AppImage"
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.6.2",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.starchap.wisp",
    "productName": "WispAI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/.venv/**"
        ]
      },
      {
        "from": "../backend-dist",
        "to": "backend-dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable",
        "zip",
        "appx"
      ],
      "icon": "public/wisp-icon.ico"
    },
    "appx": {
      "identityName": "StarChap.WispAI",
      "publisher": "CN=3C3E462B-C8B7-4B89-9DA4-2BAFE58FF6F2",
      "publisherDisplayName": "StarChap",
      "displayName": "WispAI",
      "applicationId": "WispAI",
      "languages": [
        "en-US",
        "da-DK"
      ],
      "artifactName": "${productName}-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}",
      "unpackDirName": "WispApp"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "public/wisp-icon.png",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "deb",
        "rpm",
        "AppImage"
      ],
      "icon": "public/wisp-icon.png",
      "category": "AudioVideo;Audio;Utility;",
      "maintainer": "starchap <https://github.com/starchap/Wisp>",
      "synopsis": "100% Offline Local AI Multi-Speaker Meeting Transcriber & Translator"
    },
    "rpm": {
      "fpm": [
        "--rpm-rpmbuild-define=_build_id_links none",
        "--rpm-rpmbuild-define=__os_install_post %{nil}"
      ]
    }
  }
}
